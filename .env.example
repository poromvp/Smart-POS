# =========================
# PostgreSQL & pgAdmin (Docker Compose)
# =========================
POSTGRES_USER=pos_admin
POSTGRES_PASSWORD=pos_password123
PGADMIN_EMAIL=admin@smartpos.com
PGADMIN_PASSWORD=admin123

# =========================
# Auth Service (:8081)
# =========================
AUTH_SERVER_PORT=8081
AUTH_DB_NAME=pos_identity_db
AUTH_DB_USER=pos_admin
AUTH_DB_PASSWORD=pos_password123
AUTH_DB_PORT=5433

# =========================
# Sales Service (:8083)
# =========================
SALES_DB_URL=jdbc:postgresql://127.0.0.1:5433/pos_sales_db

# =========================
# JWT TOKEN, REFRESH TOKEN & INTERNAL SECRET
# (auth-service, gateway, sales-service phải dùng chung JWT_SECRET)
# =========================
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7
JWT_REFRESH_COOKIE_NAME=refreshToken
JWT_COOKIE_SECURE=false
INTERNAL_SERVICE_SECRET=smartpos-internal-secret-2026

# =========================
# API Gateway (:8088)
# =========================
PORT=8088
AUTH_SERVICE_URL=http://localhost:8081
CATALOG_INVENTORY_URL=http://localhost:8082
SALES_SERVICE_URL=http://localhost:8083
SALES_WS_URL=http://localhost:8083
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX_REQUESTS=15
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_ORDER_MAX_REQUESTS=30
RATE_LIMIT_ORDER_WINDOW_SECONDS=60
# Chỉ bật true / framework khi Gateway đứng sau reverse proxy tin cậy (Nginx/ALB)
RATE_LIMIT_TRUST_FORWARDED_HEADERS=false
FORWARD_HEADERS_STRATEGY=none

# =========================
# Frontend (Next.js :3000)
# =========================
API_GATEWAY_URL=http://localhost:8088
NEXT_PUBLIC_WS_URL=ws://localhost:8088/ws-pos
