# =========================
# Auth Service
# =========================
AUTH_SERVER_PORT=8081

# =========================
# PostgreSQL - Auth Database
# =========================
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change_me_to_a_strong_password
AUTH_DB_PORT=5433

# =========================
# JWT TOKEN & REFRESH TOKEN
# =========================
JWT_SECRET=your_generated_base64_secret
JWT_ACCESS_TOKEN_EXPIRATION=900000        # 15 minutes
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7      # 7 days
JWT_REFRESH_COOKIE_NAME=refreshToken