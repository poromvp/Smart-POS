# ==========================================
# CẤU HÌNH MÔI TRƯỜNG PRODUCTION (AZURE / CLOUD)
# Copy file này thành .env trên máy chủ
# ==========================================

# 1. PostgreSQL Database
POSTGRES_USER=pos_admin
POSTGRES_PASSWORD=pos_password123

# 2. JWT & Internal Security
# Sinh chuỗi bí mật an toàn ngẫu nhiên
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7
INTERNAL_SERVICE_SECRET=smartpos-prod-internal-secret-2026

# 3. Spring Profile & Web Port
SPRING_PROFILES_ACTIVE=dev
# Cổng mở ra ngoài của Nginx (mặc định trên server là 80)
WEB_PORT=80
